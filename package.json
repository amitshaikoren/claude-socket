{
  "name": "claude-socket",
  "version": "0.1.0",
  "type": "module",
  "description": "Point any OpenAI or Anthropic client at your own Claude Code install, with per-tool-call token accounting.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "openai",
    "openai-compatible",
    "openai-api",
    "llm",
    "proxy",
    "agents",
    "token-counting",
    "cli"
  ],
  "homepage": "https://github.com/amitshaikoren/claude-socket#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitshaikoren/claude-socket.git"
  },
  "bugs": {
    "url": "https://github.com/amitshaikoren/claude-socket/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "src",
    "socket.config.example.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "claude-socket": "./src/index.ts",
    "claude-socket-cli": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "cli": "node src/cli.ts",
    "watch": "node src/cli.ts watch",
    "chat": "node src/cli.ts chat",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
